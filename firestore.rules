rules_version = '2';

// Two-way pairing: every phone in a pair is guarded by the other one.
//
// Data layout
//   pairs/{pairId}                       a (creator uid), b (joiner uid | null), createdAt
//   pairs/{pairId}/phones/{uid}          health of ONE phone (written only by that phone)
//   pairs/{pairId}/phones/{uid}/apps/*   apps locked ON that phone
//   pairs/{pairId}/phones/{uid}/usage/*  screen time of that phone, one doc per day
//
// "Easy to lock, hard to unlock" is enforced here, on the SERVER: the owner of a phone can only
// add locks; only the OTHER member of the pair can loosen or remove them.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function pairDoc(pairId) {
      return get(/databases/$(database)/documents/pairs/$(pairId)).data;
    }
    function isMember(pairId) {
      return signedIn() && (pairDoc(pairId).a == request.auth.uid || pairDoc(pairId).b == request.auth.uid);
    }
    // The signed-in user is the phone's owner (and a member of the pair).
    function isOwner(pairId, phone) {
      return signedIn() && request.auth.uid == phone && isMember(pairId);
    }
    // The signed-in user is the OTHER member: the guardian of that phone.
    function isGuardianOf(pairId, phone) {
      return isMember(pairId)
        && request.auth.uid != phone
        && (pairDoc(pairId).a == phone || pairDoc(pairId).b == phone);
    }

    match /pairs/{pairId} {
      // Anyone signed in may fetch an UNCLAIMED pair by its (unguessable, 8-char) id to join it.
      // Listing/querying is never allowed.
      // (resource == null: a missing doc reads as "not found" instead of "permission denied".)
      allow get: if signedIn() && (
        resource == null ||
        resource.data.b == null ||
        resource.data.a == request.auth.uid ||
        resource.data.b == request.auth.uid
      );
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.a == request.auth.uid
        && request.resource.data.b == null
        && request.resource.data.keys().hasOnly(['a', 'b', 'createdAt']);

      // Only the second phone can join, only once, and only by filling in "b".
      allow update: if signedIn()
        && resource.data.b == null
        && resource.data.a != request.auth.uid
        && request.resource.data.b == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['b']);

      allow delete: if false;

      // ---------- health ----------
      match /phones/{phone} {
        allow read: if isMember(pairId);
        allow create, update: if isOwner(pairId, phone)
          && request.resource.data.keys().hasOnly([
            'lastHeartbeat', 'accessibilityOn', 'batteryExempt', 'deviceAdmin',
            'notificationsOn', 'usageAccess', 'hardened'
          ]);
        allow delete: if false;

        // ---------- locked apps ----------
        match /apps/{pkg} {
          allow read: if isMember(pairId);

          allow create: if isGuardianOf(pairId, phone) || (
            isOwner(pairId, phone)
            && request.resource.data.keys().hasOnly(['name', 'addedBy', 'locked', 'unlockUntil'])
            && request.resource.data.addedBy == 'self'
            && request.resource.data.locked == true
            && request.resource.data.get('unlockUntil', null) == null
          );

          // The owner may only (re)lock: locked must end up true with no open window.
          allow update: if isGuardianOf(pairId, phone) || (
            isOwner(pairId, phone)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'locked', 'unlockUntil'])
            && request.resource.data.locked == true
            && request.resource.data.get('unlockUntil', null) == null
          );

          allow delete: if isGuardianOf(pairId, phone);
        }

        // ---------- screen time ----------
        match /usage/{day} {
          allow read: if isMember(pairId);
          allow create, update: if isOwner(pairId, phone)
            && request.resource.data.keys().hasOnly(['total', 'top', 'updatedAt'])
            && request.resource.data.top.size() <= 30;
          allow delete: if false;
        }
      }
    }
  }
}
